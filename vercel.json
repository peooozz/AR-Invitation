{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=*, gyroscope=*, accelerometer=*, magnetometer=*" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
